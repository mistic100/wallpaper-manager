{
  "name": "wallpaper-manager",
  "version": "1.0.0",
  "description": "A Windows application for scanning a source folder, reviewing images, choosing a crop/size preset, recompressing to JPEG, and moving the file to a target folder.",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "main": "src/main.js",
  "author": {
    "name": "StrangePlanet",
    "url": "https://strangeplanet.fr"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "fr.strangeplanet.wallpaper-manager",
    "productName": "Wallpaper Manager",
    "asar": true,
    "electronLanguages": [
      "en"
    ],
    "win": {
      "target": "portable",
      "icon": "src/icon.png"
    }
  }
}
